{
  "name": "polymarket-spreads",
  "version": "1.0.0",
  "description": "Full-stack application displaying Polymarket prediction markets with real-time bid-ask spreads",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm start --workspace=backend"
  },
  "keywords": [
    "polymarket",
    "prediction-markets",
    "order-book",
    "spreads"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
